# Xcode — project is generated by `scripts/generate-project.sh` (xcodegen).
# Ignore the whole bundle EXCEPT the SwiftPM lockfile, which we commit so
# every clone resolves to the exact same dependency versions.
SayMoore.xcodeproj/*
!SayMoore.xcodeproj/project.xcworkspace/
SayMoore.xcodeproj/project.xcworkspace/*
!SayMoore.xcodeproj/project.xcworkspace/xcshareddata/
SayMoore.xcodeproj/project.xcworkspace/xcshareddata/*
!SayMoore.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
SayMoore.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!SayMoore.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
build/
DerivedData/
*.xcuserdata/
*.xcuserstate
xcuserdata/
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.swp

# Swift Package Manager
.build/
.swiftpm/

# Signing & secrets
*.p12
*.cer
*.mobileprovision
sparkle-ed25519.key
*.eddsa
.env
.env.*

# SayMoore runtime data (never check in user data or models)
presets.json
history.jsonl
models/
SayMoore/Resources/presets.json

# Vendored whisper.cpp XCFramework (~200 MB; produced by scripts/setup-whisper.sh)
Vendor/whisper.xcframework/
Vendor/.whisper-version

# Vendored Silero VAD ONNX model (~2 MB; produced by scripts/setup-silero.sh)
Vendor/silero-vad/
SayMoore/Resources/silero_vad.onnx

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# IDE
.idea/
.vscode/
*.iml

# Slice 11 — release artifacts
release/
*.xcarchive

# Superpowers brainstorming session artifacts (HTML mockups, server state)
.superpowers/

# Misc
*.log
*.bak
*.tmp

# Local Claude Code state (per-machine, never share)
.claude/
